# DeckApp environment variables
#
# DeckApp is configured per-product mainly through /config/product.ts.
# These variables are reserved for future phases (see docs/ROADMAP.md):
# real auth, payment webhooks and Supabase.

# Public base URL of this product instance (used for deep links / metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

